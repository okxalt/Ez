// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// For local development we use SQLite. In production (Vercel/Supabase), set DATABASE_URL to Postgres.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Sellers are Whop sellers who configure challenges
model Seller {
  id          String    @id @default(uuid())
  whopUserId  String    @unique
  createdAt   DateTime  @default(now())
  challenges  Challenge[]
}

// Challenge defines a goal for a specific Whop product
model Challenge {
  id                String       @id @default(uuid())
  sellerId          String
  seller            Seller       @relation(fields: [sellerId], references: [id])
  whopProductId     String
  title             String
  description       String?
  minimumViewCount  Int
  isActive          Boolean      @default(true)
  submissions       Submission[]

  @@index([sellerId])
  @@index([whopProductId])
}

// Member submission for a challenge
model Submission {
  id                 String            @id @default(uuid())
  challengeId        String
  challenge          Challenge         @relation(fields: [challengeId], references: [id])
  memberWhopUserId   String
  memberWhopUsername String
  originalVideoUrl   String
  videoMetadata      Json
  analyticsVideoUrl  String?
  status             SubmissionStatus  @default(submitted)
  submittedAt        DateTime          @default(now())
  approvedAt         DateTime?

  @@index([challengeId])
  @@index([memberWhopUserId])
  @@index([status])
}

enum SubmissionStatus {
  submitted
  awaiting_analytics
  pending_review
  approved
  rejected
}
